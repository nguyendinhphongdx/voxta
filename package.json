{
  "name": "@hanoilab/voxta",
  "version": "0.1.0",
  "description": "Voice-first client cho các agent platform tự host (Ultron, Hermes, Claude Code, terminal từ xa)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyendinhphongdx/voxta.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "voxta": "./bin/cli.js"
  },
  "files": [
    "bin",
    ".next/standalone"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "prepare:standalone": "./scripts/prepare-standalone.sh",
    "cli": "node bin/cli.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && ./scripts/prepare-standalone.sh && changeset publish",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:logs": "docker compose logs -f app"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ricky0123/vad-web": "0.0.31",
    "@tailwindcss/postcss": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "onnxruntime-web": "1.22.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
